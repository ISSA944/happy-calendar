generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// CORE: users + auth credentials
// ─────────────────────────────────────────────────────────────
model User {
  id                      String    @id @default(uuid())
  email                   String    @unique
  name                    String?
  passwordHash            String?   @map("password_hash")
  otpHash                 String?   @map("otp_hash")
  otpExpiresAt            DateTime? @map("otp_expires_at")
  otpFailedAttempts       Int       @default(0) @map("otp_failed_attempts")
  otpLastFailedAt         DateTime? @map("otp_last_failed_at")
  pendingEmail            String?   @map("pending_email")
  emailChangeOtpHash      String?   @map("email_change_otp_hash")
  emailChangeOtpExpiresAt DateTime? @map("email_change_otp_expires_at")
  refreshTokenHash        String?   @map("refresh_token_hash")
  emailVerifiedAt         DateTime? @map("email_verified_at")
  welcomeEmailSentAt      DateTime? @map("welcome_email_sent_at")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  profile                 Profile?
  prefs                   Prefs?
  dailyFeeds              DailyFeed[]
  bookmarks               Bookmark[]
  moodLogs                MoodLog[]
  notifications           Notification[]
  webPushSubscriptions    WebPushSubscription[]
  userGoals               UserGoal[]
  personalCareCompletions PersonalCareCompletion[]

  @@map("users")
}

// ─────────────────────────────────────────────────────────────
// PROFILE: кто такой юзер (астрология + текущее настроение)
// ─────────────────────────────────────────────────────────────
model Profile {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  birthdate   String?
  zodiacSign  String?  @map("zodiac_sign")
  gender      String?
  avatarUrl   String?  @map("avatar_url")
  currentMood String   @default("Нормально") @map("current_mood")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("profile")
}

// ─────────────────────────────────────────────────────────────
// PREFS: настройки + устройства + согласие ПД
// ─────────────────────────────────────────────────────────────
model Prefs {
  id                  String   @id @default(uuid())
  userId              String   @unique @map("user_id")
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pushTime            String   @default("09:00") @map("push_time")
  horoscopeEnabled    Boolean  @default(true) @map("horoscope_enabled")
  holidaysEnabled     Boolean  @default(false) @map("holidays_enabled")
  supportEnabled      Boolean  @default(true) @map("support_enabled")
  personalCareEnabled Boolean  @default(true) @map("personal_care_enabled")
  // Per-category push times (HH:MM, user's LOCAL wall-clock time — matched against
  // `timezone` below in NotificationCronService, not raw UTC). horoscopeTime seeded from
  // legacy pushTime in migration.
  horoscopeTime       String   @default("09:00") @map("horoscope_time")
  supportTime         String   @default("12:00") @map("support_time")
  holidaysTime        String   @default("10:00") @map("holidays_time")
  personalCareTime    String   @default("08:30") @map("personal_care_time")
  consentPd           Boolean  @default(false) @map("consent_pd")
  marketingConsent    Boolean  @default(false) @map("marketing_consent")
  timezone            String   @default("Europe/Moscow")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("prefs")
}

// ─────────────────────────────────────────────────────────────
// SHARED REF TABLES — расшариваются между юзерами
// Экономия LLM: 1 гороскоп на (date, zodiacSign) на всех
// ─────────────────────────────────────────────────────────────
model Horoscope {
  id         String   @id @default(uuid())
  date       String
  zodiacSign String   @map("zodiac_sign")
  main       String
  detailed   String?
  advice     String
  moon       String
  aspect     String
  createdAt  DateTime @default(now()) @map("created_at")

  dailyFeeds DailyFeed[]

  @@unique([date, zodiacSign])
  @@index([date])
  @@map("horoscopes")
}

model Holiday {
  id          String   @id @default(uuid())
  date        String   @unique
  title       String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  dailyFeeds DailyFeed[]

  @@map("holidays")
}

model SupportPhrase {
  id        String   @id @default(uuid())
  mood      String
  text      String
  usedCount Int      @default(0) @map("used_count")
  createdAt DateTime @default(now()) @map("created_at")

  dailyFeeds DailyFeed[]

  @@index([mood])
  @@map("support_phrases")
}

model Prompt {
  id        String   @id @default(uuid())
  type      String   @unique
  template  String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("prompts")
}

// ─────────────────────────────────────────────────────────────
// DAILY FEED: join-таблица user↔ref-content на конкретный день
// ─────────────────────────────────────────────────────────────
model DailyFeed {
  id              String         @id @default(uuid())
  userId          String         @map("user_id")
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  date            String
  horoscopeId     String?        @map("horoscope_id")
  horoscope       Horoscope?     @relation(fields: [horoscopeId], references: [id])
  supportPhraseId String?        @map("support_phrase_id")
  supportPhrase   SupportPhrase? @relation(fields: [supportPhraseId], references: [id])
  holidayId       String?        @map("holiday_id")
  holiday         Holiday?       @relation(fields: [holidayId], references: [id])
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@unique([userId, date])
  @@map("daily_feed")
}

// ─────────────────────────────────────────────────────────────
// BOOKMARKS: snapshot на момент сохранения (immutable)
// ─────────────────────────────────────────────────────────────
model Bookmark {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  payload   Json
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("bookmarks")
}

// ─────────────────────────────────────────────────────────────
// AUDIT LOGS
// ─────────────────────────────────────────────────────────────
model MoodLog {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mood      String
  changedAt DateTime @default(now()) @map("changed_at")

  @@index([userId])
  @@map("mood_logs")
}

model Notification {
  id     String   @id @default(uuid())
  userId String   @map("user_id")
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sentAt DateTime @default(now()) @map("sent_at")
  type   String
  status String
  title  String?
  body   String?
  date   String?
  mood   String?

  @@index([userId])
  @@map("notifications")
}

model WebPushSubscription {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("web_push_subscriptions")
}

// ─────────────────────────────────────────────────────────────
// GOALS: выбранные пользователем цели (ТЗ п. 4.2 / 6.4)
// Прогресс НЕ хранится здесь — считается по PersonalCareCompletion.
// active=false → «не активна», прогресс сохраняется, можно вернуть.
// ─────────────────────────────────────────────────────────────
model UserGoal {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalId    String   @map("goal_id") // 'calm' | 'hear' | 'food' | 'move' — см. GOALS в src/goals
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, goalId])
  @@index([userId])
  @@map("user_goals")
}

// ─────────────────────────────────────────────────────────────
// PERSONAL CARE: справочник дней заботы (ТЗ п. 6.2) — общий на всех.
// Импортируется из клиентской таблицы «Личные праздники» (scripts/import-personal-care.ts).
// ─────────────────────────────────────────────────────────────
// dayOfYear: 1..365, адресует день по номеру года (реальный клиентский контент, xlsx «Личные праздники»).
// NULL — только у legacy-строк из старого прототипного сида, которые больше не выбираются в getToday(),
// но остаются в таблице ради FK-целостности старых PersonalCareCompletion (RESTRICT, не удаляем).
// На каждую цель — свой task/advice (а не общий task+affirmation с тегами, как раньше): контент от
// клиента различается по цели, поэтому 4 отдельные пары полей вместо goalTags.
model PersonalCareDay {
  id        String @id @default(uuid())
  dayOfYear Int?   @unique @map("day_of_year")
  title     String
  themeKey  String @map("theme_key") // одна из 19 тем п. 7.4

  calmTask   String @map("calm_task")
  calmAdvice String @map("calm_advice")
  hearTask   String @map("hear_task")
  hearAdvice String @map("hear_advice")
  foodTask   String @map("food_task")
  foodAdvice String @map("food_advice")
  moveTask   String @map("move_task")
  moveAdvice String @map("move_advice")

  createdAt DateTime @default(now()) @map("created_at")

  completions PersonalCareCompletion[]

  @@map("personal_care_days")
}

// ─────────────────────────────────────────────────────────────
// PERSONAL CARE COMPLETION: «Я сделала это» — один зачёт в день.
// Прогресс цели = count(completions с тегом этой цели).
// ─────────────────────────────────────────────────────────────
model PersonalCareCompletion {
  id                String          @id @default(uuid())
  userId            String          @map("user_id")
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  personalCareDayId String          @map("personal_care_day_id")
  personalCareDay   PersonalCareDay @relation(fields: [personalCareDayId], references: [id])
  goalId            String          @map("goal_id") // какая из 4 целей засчитана в этот день — теперь
  // засчитывается независимо на каждую активную цель юзера (см. PersonalCareService.getToday()),
  // а не одна ротируемая цель на весь день, поэтому уникальность теперь тройная (userId, date, goalId).
  date              String // DD.MM.YYYY, локальная дата юзера
  completedAt       DateTime        @default(now()) @map("completed_at")

  @@unique([userId, date, goalId])
  @@index([userId])
  @@map("personal_care_completions")
}

// ─────────────────────────────────────────────────────────────
// CALENDAR HOLIDAYS: праздники + открытки в 3 тонах (ТЗ п. 2/5).
// Импорт из Праздники_поздравления_2026.xlsx. Ключ — date (DD.MM).
// На одну дату может быть несколько строк.
// ─────────────────────────────────────────────────────────────
model CalendarHoliday {
  id           String  @id @default(uuid())
  date         String // DD.MM — год условный, праздники ежегодные
  title        String
  cute         String
  humor        String
  cynical      String
  themeKey     String  @map("theme_key")
  scope        String  @default("ru") // 'ru' | 'intl' — размётка от клиента ожидается
  postcardKey  String? @map("postcard_key")
  postcardPack String? @map("postcard_pack")

  @@index([date])
  @@map("calendar_holidays")
}

// ─────────────────────────────────────────────────────────────
// HOLIDAY IMAGES: legacy-фоны для праздников без готового версионированного пака (ТЗ п. 7.1).
// При отсутствии и пака, и записи здесь фронт рендерит CSS-градиент по themeKey.
// ─────────────────────────────────────────────────────────────
model HolidayImage {
  id                String  @id @default(uuid())
  calendarHolidayId String? @map("calendar_holiday_id")
  personalCareDayId String? @map("personal_care_day_id")
  themeKey          String  @map("theme_key")
  url               String

  @@index([themeKey])
  @@map("holiday_images")
}

// ─────────────────────────────────────────────────────────────
// PUSH MILESTONES: шаблоны пушей по вехам целей (ТЗ п. 3).
// Импорт из Пуши_мотивация_целей.xlsx (лист «Пуши по вехам»).
// ─────────────────────────────────────────────────────────────
model PushMilestoneTemplate {
  milestone Int    @id // 1,5,10,...,365
  emoji     String
  title     String
  body      String // содержит {имя}

  @@map("push_milestone_templates")
}
