DATABASE_URL=postgresql://postgres:password@db:5432/yoyojoy_day?schema=public
PORT=4000
NODE_ENV=production

AI_API_KEY=
# https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1
AI_BASE_URL=
AI_MODEL=@cf/openai/gpt-oss-120b
REDIS_URL=redis://redis:6379

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=YoYoJoy Day

RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Кнопки Телеграм/МАКС в письме с подарком — без них кнопки просто не рендерятся
TELEGRAM_CHANNEL_URL=
MAX_CHANNEL_URL=

# Web Push VAPID. Generate the pair once and keep the private key only in the
# production environment. The public key is fetched by authenticated clients at
# runtime from GET /api/push/public-key; do not put it in VITE_ variables.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:support@yoyojoy.online
